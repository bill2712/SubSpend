{
  "name": "subspend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free, private subscription tracker. All data stays in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-content.mjs",
    "og": "node scripts/generate-og.mjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:a11y": "node tests/a11y.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
