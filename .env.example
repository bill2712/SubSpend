# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG tags.
VITE_SITE_URL=https://example.com
# Google AdSense publisher ID. Leave the placeholder to disable ads entirely.
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Buy Me a Coffee page.
VITE_BMC_URL=https://buymeacoffee.com/YOUR_USERNAME
# Contact email shown on the Contact page.
VITE_CONTACT_EMAIL=hello@example.com
